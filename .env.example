# Firebase config for Google login + cross-device cloud sync.
# Get these values from Firebase console -> Project settings -> General ->
# "Your apps" -> Web app. Optional: without them, the app runs fine in
# local-only guest mode (no login, data stays in this browser).
#
# For local dev, copy this file to .env.local and fill in real values.
# For the GitHub Pages deploy, set the same names as repo secrets
# (Settings -> Secrets and variables -> Actions) instead.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
